type R = tag: I32

impl drop_r: Drop R with
    drop (r: mut R) =
        print "drop "
        println r.tag

consume (var r: R): Unit = drop (mut r)

main () =
    var a = R 1
    var b = R 2
    consume b
    drop (mut a)

// args: --delete-binary --no-color
// expected stdout:
// drop 2
// drop 1
