get_closure () =
    msg = "hi"
    stuff = move fn () -> println msg
    stuff

main () =
    // returned closure (the closure_return.an pattern)
    f = get_closure ()
    f ()

    // a capturing closure created and discarded each loop iteration
    var i = 0
    while i < 3 do
        n = i
        g = fn () -> println (n + 10)
        g ()
        i := i + 1

    // a move closure capturing by value
    var x = 100
    m = move fn () -> println x
    x := 200
    m ()
    println x

    // A move closure capturing an OWNED (heap) String by value.
    // The env is its sole owner (the move is recorded; the outer scope can neither use
    // nor drop `owned`), so when the closure dies un-moved its capture is dropped --
    // the heap buffer is freed here, not leaked.
    payload = "moved " ++ "string"
    p = move fn () -> println payload
    p ()

// args: --delete-binary --no-color
// expected stdout:
// hi
// 10
// 11
// 12
// 100
// 200
// moved string
