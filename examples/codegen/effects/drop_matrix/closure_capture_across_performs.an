// A closure capturing an owned String is called on both sides of a suspension.
//
// The calls work correctly across the resume; the captured String leaks 21 bytes.
// Effects do not cause leaks beyond that.

effect Ask =
    ask: fn Unit -> I32

compute (): I32 can Ask =
    part = "closure payload" ++ "!"
    shout = fn () ->
        print "shout "
        println part
    shout ()
    x = ask ()
    shout ()
    x

run (f: fn Unit => I32 can Ask): I32 =
    handler h for ask () ->
        println "arm"
        res = resume 1
        res
    f ()

control () =
    part = "control payload" ++ "!"
    shout = fn () ->
        print "control "
        println part
    shout ()
    shout ()

main () =
    println (run compute)
    control ()

// args: --delete-binary --no-color
// expected stdout:
// shout closure payload!
// arm
// shout closure payload!
// 1
// control control payload!
// control control payload!
