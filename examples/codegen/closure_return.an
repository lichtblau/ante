// A returned closure may not *borrow* an owned local -- the capture would outlive
// `foo`. It must own it, so the closure is `move`.
get_closure () =
    foo = "hi there"
    stuff = move fn () -> println foo
    stuff

main () =
    foo = get_closure ()
    foo ()

// args: --delete-binary --no-color
// expected stdout: hi there

