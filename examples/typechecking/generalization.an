// `move` because `y` escapes `foo` while capturing the owned parameter `x`,
// which `foo` frees on return. The generalization this pins is unaffected.
foo x =
    y = move fn _ -> x
    y

// args: -e ast-t --no-color
// expected stdout:
// (foo: fn _ -> fn _ [_] -> _ pure pure) (x: _) =
//     (y: fn _ [_] -> _ pure) (_: _) [(x: _)] = (x: _)
//     (y: fn _ [_] -> _ pure)

