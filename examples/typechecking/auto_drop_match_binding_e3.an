type Res = tag: I32
make (): Res = Res 1
consume (_r: Res): Unit = ()

test_e3 (m: Maybe Res): Unit =
    match m
    | Some r -> consume r
    | None -> ()
    match m
    | Some r2 -> consume r2
    | None -> ()

main () =
    x: Maybe Res = Some (make ())
    test_e3 x

