type Res = tag: I32
make (): Res = Res 1
consume (_r: Res): Unit = ()
consume_m (_v: Maybe Res): Unit = ()

test_e (m: Maybe Res): Unit =
    match m
    | Some r -> consume r
    | None -> ()
    consume_m m

main () =
    x: Maybe Res = Some (make ())
    test_e x

